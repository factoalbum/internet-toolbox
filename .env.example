# Optional production site URL. Keep the GitHub Pages fallback when deploying there.
NEXT_PUBLIC_SITE_URL=https://factoalbum.github.io/internet-toolbox

# Optional Google Analytics measurement ID, for example G-XXXXXXXXXX.
# Analytics is loaded only after visitor consent.
NEXT_PUBLIC_GA_ID=

# Optional Google Search Console HTML verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
